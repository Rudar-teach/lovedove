# Supabase Configuration
# Get these from: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE

# Resend Email (for proposal notifications)
# Sign up at resend.com (free: 100 emails/day)
# Run: npx resend init to configure
RESEND_API_KEY=re_YOUR_RESEND_API_KEY_HERE
RESEND_FROM_EMAIL=Love Dove <onboarding@resend.dev>

# Optional: override default notification recipient email
PROPOSAL_NOTIFICATION_EMAIL=rudarsalaria12345@gmail.com
